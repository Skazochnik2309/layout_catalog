{
  "id": "catalog_test",
  "viewports": [
    {
      "label": "1024px",
      "width": 1024,
      "height": 768
    },
    {
      "label": "1200px",
      "width": 1200,
      "height": 800
    }
  ],
  "onBeforeScript": "puppet/onBefore.js",
  "onReadyScript": "puppet/onReady.js",
  "scenarios": [
    {
      "label": "Entire document",
      "url": "http://localhost:3000/",
      "readySelector": "body",
      "delay": 2000,
      "selectors": [
        "body"
      ]
    },
    {
      "label": "Header",
      "url": "http://localhost:3000/",
      "readySelector": "body",
      "delay": 2000,
      "selectors": [
        ".header"
      ]
    },
    {
      "label": "Nav",
      "url": "http://localhost:3000/",
      "readySelector": "body",
      "delay": 2000,
      "selectors": [
        ".nav"
      ]
    },
    {
      "label": "Link with data-qa hover",
      "url": "http://localhost:3000/",
      "readySelector": "body",
      "delay": 2000,
      "hoverSelector": "[data-qa=\"nav-hover\"]",
      "selectors": [
        "[data-qa=\"nav-hover\"]"
      ]
    },
    {
      "label": "Link with class is-active",
      "url": "http://localhost:3000/",
      "readySelector": "body",
      "delay": 2000,
      "selectors": [
        ".is-active"
      ]
    },
    {
      "label": "Main",
      "url": "http://localhost:3000/",
      "readySelector": "body",
      "delay": 2000,
      "selectors": [
        "main"
      ]
    },
    {
      "label": "Card with data-qa card",
      "url": "http://localhost:3000/",
      "readySelector": "body",
      "delay": 2000,
      "selectors": [
        "[data-qa=\"card\"]"
      ]
    }
  ],
  "paths": {
    "bitmaps_reference": "backstop_data/bitmaps_reference",
    "bitmaps_test": "backstop_data/bitmaps_test",
    "engine_scripts": "backstop_data/engine_scripts",
    "html_report": "backstop_data/html_report",
    "ci_report": "backstop_data/ci_report"
  },
  "report": [
    "browser"
  ],
  "engine": "puppeteer",
  "engineOptions": {
    "args": [
      "--no-sandbox"
    ]
  },
  "asyncCaptureLimit": 5,
  "asyncCompareLimit": 50,
  "debug": false,
  "debugWindow": false
}